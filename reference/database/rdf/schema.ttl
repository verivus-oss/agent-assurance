# DAG-TOML ontology as RDF/Turtle (non-normative reference).
# Generated by tools/dagtoml-rdf from core/ontology.toml +
# every profiles/<name>/ontology.toml. Do not hand-edit;
# re-run `cargo run -p dagtoml-rdf` instead.

@prefix dagtoml: <https://verivus-oss.org/dagtoml/v1#> .
@prefix dagprof: <https://verivus-oss.org/dagtoml/profile/agent-assurance/v1#> .
@prefix ijb:     <https://verivus-oss.org/dagtoml/ijb/v1#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

###
### IJB primitives (spec.md §10)
###

ijb:Thing a rdfs:Class ;
    rdfs:label "thing" .

ijb:Scope a rdfs:Class ;
    rdfs:label "scope" .

ijb:Path a rdfs:Class ;
    rdfs:label "path" .

ijb:Observed a rdfs:Class ;
    rdfs:label "observed" .

ijb:Constraint a rdfs:Class ;
    rdfs:label "constraint" .

ijb:Time a rdfs:Class ;
    rdfs:label "time" .

###
### Template kinds (23 = core + every profile + 1 meta)
###

dagtoml:KindDescriptor a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "kind-descriptor" ;
    rdfs:comment "Self-contained template descriptor for a DAG-TOML kind." .

dagtoml:KindDescriptorKind a dagtoml:KindDescriptor ;
    dagtoml:templateKind   "kind-descriptor" ;
    dagtoml:layer          "core" ;
    dagtoml:descriptorPath "spec.md" .

dagtoml:ContractDeclarationKind a dagtoml:KindDescriptor ;
    dagtoml:templateKind   "contract-declaration" ;
    dagtoml:layer          "core" ;
    dagtoml:descriptorPath "core/contract-declaration-kind.toml" .

dagtoml:EvidenceMatrixKind a dagtoml:KindDescriptor ;
    dagtoml:templateKind   "evidence-matrix" ;
    dagtoml:layer          "core" ;
    dagtoml:descriptorPath "core/evidence-matrix-kind.toml" .

dagtoml:ImplementationDagKind a dagtoml:KindDescriptor ;
    dagtoml:templateKind   "implementation-dag" ;
    dagtoml:layer          "core" ;
    dagtoml:descriptorPath "core/implementation-dag-kind.toml" .

dagtoml:ProfileDescriptorKind a dagtoml:KindDescriptor ;
    dagtoml:templateKind   "profile-descriptor" ;
    dagtoml:layer          "core" ;
    dagtoml:descriptorPath "core/profile-descriptor-kind.toml" .

dagtoml:ReadinessGateKind a dagtoml:KindDescriptor ;
    dagtoml:templateKind   "readiness-gate" ;
    dagtoml:layer          "core" ;
    dagtoml:descriptorPath "core/readiness-gate-kind.toml" .

dagtoml:TraceabilityKind a dagtoml:KindDescriptor ;
    dagtoml:templateKind   "traceability" ;
    dagtoml:layer          "core" ;
    dagtoml:descriptorPath "core/traceability-kind.toml" .

dagtoml:AdapterContractKind a dagtoml:KindDescriptor ;
    dagtoml:templateKind   "adapter-contract" ;
    dagtoml:layer          "profile:agent-assurance" ;
    dagtoml:descriptorPath "profiles/agent-assurance/adapter-contract-kind.toml" .

dagtoml:AdapterRegistryBindingKind a dagtoml:KindDescriptor ;
    dagtoml:templateKind   "adapter-registry-binding" ;
    dagtoml:layer          "profile:agent-assurance" ;
    dagtoml:descriptorPath "profiles/agent-assurance/adapter-registry-binding-kind.toml" .

dagtoml:AssertionBundleKind a dagtoml:KindDescriptor ;
    dagtoml:templateKind   "assertion-bundle" ;
    dagtoml:layer          "profile:agent-assurance" ;
    dagtoml:descriptorPath "profiles/agent-assurance/assertion-bundle-kind.toml" .

dagtoml:AssertionLogRecordKind a dagtoml:KindDescriptor ;
    dagtoml:templateKind   "assertion-log-record" ;
    dagtoml:layer          "profile:agent-assurance" ;
    dagtoml:descriptorPath "profiles/agent-assurance/assertion-log-record-kind.toml" .

dagtoml:GateDecisionKind a dagtoml:KindDescriptor ;
    dagtoml:templateKind   "gate-decision" ;
    dagtoml:layer          "profile:agent-assurance" ;
    dagtoml:descriptorPath "profiles/agent-assurance/gate-decision-kind.toml" .

dagtoml:RollbackPlanKind a dagtoml:KindDescriptor ;
    dagtoml:templateKind   "rollback-plan" ;
    dagtoml:layer          "profile:agent-assurance" ;
    dagtoml:descriptorPath "profiles/agent-assurance/rollback-plan-kind.toml" .

dagtoml:SmokeValidationKind a dagtoml:KindDescriptor ;
    dagtoml:templateKind   "smoke-validation" ;
    dagtoml:layer          "profile:agent-assurance" ;
    dagtoml:descriptorPath "profiles/agent-assurance/smoke-validation-kind.toml" .

dagtoml:SpecContractKind a dagtoml:KindDescriptor ;
    dagtoml:templateKind   "spec-contract" ;
    dagtoml:layer          "profile:agent-assurance" ;
    dagtoml:descriptorPath "profiles/agent-assurance/spec-contract-kind.toml" .

dagtoml:ThreatModelKind a dagtoml:KindDescriptor ;
    dagtoml:templateKind   "threat-model" ;
    dagtoml:layer          "profile:agent-assurance" ;
    dagtoml:descriptorPath "profiles/agent-assurance/threat-model-kind.toml" .

dagtoml:ApiSnapshotKind a dagtoml:KindDescriptor ;
    dagtoml:templateKind   "api-snapshot" ;
    dagtoml:layer          "profile:com.verivus.runtime" ;
    dagtoml:descriptorPath "profiles/com.verivus.runtime/api-snapshot-kind.toml" .

dagtoml:MutationClaimKind a dagtoml:KindDescriptor ;
    dagtoml:templateKind   "mutation-claim" ;
    dagtoml:layer          "profile:com.verivus.runtime" ;
    dagtoml:descriptorPath "profiles/com.verivus.runtime/mutation-claim-kind.toml" .

dagtoml:StateMutationKind a dagtoml:KindDescriptor ;
    dagtoml:templateKind   "state-mutation" ;
    dagtoml:layer          "profile:com.verivus.runtime" ;
    dagtoml:descriptorPath "profiles/com.verivus.runtime/state-mutation-kind.toml" .

dagtoml:CostRecordKind a dagtoml:KindDescriptor ;
    dagtoml:templateKind   "cost-record" ;
    dagtoml:layer          "profile:cost" ;
    dagtoml:descriptorPath "profiles/cost/cost-record-kind.toml" .

dagtoml:DisclosureAttestationKind a dagtoml:KindDescriptor ;
    dagtoml:templateKind   "disclosure-attestation" ;
    dagtoml:layer          "profile:disclosure" ;
    dagtoml:descriptorPath "profiles/disclosure/disclosure-attestation-kind.toml" .

dagtoml:RedactionManifestKind a dagtoml:KindDescriptor ;
    dagtoml:templateKind   "redaction-manifest" ;
    dagtoml:layer          "profile:disclosure" ;
    dagtoml:descriptorPath "profiles/disclosure/redaction-manifest-kind.toml" .

dagtoml:SelectiveDisclosureProofKind a dagtoml:KindDescriptor ;
    dagtoml:templateKind   "selective-disclosure-proof" ;
    dagtoml:layer          "profile:disclosure" ;
    dagtoml:descriptorPath "profiles/disclosure/selective-disclosure-proof-kind.toml" .

###
### Entity kinds (27, all ijb:Thing)
###

dagtoml:Intent a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "intent" ;
    dagtoml:layer "core" ;
    dagtoml:idPrefix "INT" ;
    dagtoml:section "intents" ;
    dagtoml:definedByKind "traceability" ;
    rdfs:comment "User or business intent. Top of the trace." .

dagtoml:Feature a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "feature" ;
    dagtoml:layer "core" ;
    dagtoml:idPrefix "FEAT" ;
    dagtoml:section "features" ;
    dagtoml:definedByKind "traceability" ;
    rdfs:comment "User-visible capability or feature." .

dagtoml:Requirement a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "requirement" ;
    dagtoml:layer "core" ;
    dagtoml:idPrefix "REQ" ;
    dagtoml:section "requirements" ;
    dagtoml:definedByKind "traceability" ;
    rdfs:comment "Normative, testable requirement." .

dagtoml:Regulation a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "regulation" ;
    dagtoml:layer "core" ;
    dagtoml:idPrefix "REG" ;
    dagtoml:section "regulations" ;
    dagtoml:definedByKind "traceability" ;
    rdfs:comment "Legal, policy, or regulatory obligation." .

dagtoml:Decision a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "decision" ;
    dagtoml:layer "core" ;
    dagtoml:idPrefix "DEC" ;
    dagtoml:section "decisions" ;
    dagtoml:definedByKind "traceability" ;
    rdfs:comment "Design or policy decision." .

dagtoml:Implementation a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "implementation" ;
    dagtoml:layer "core" ;
    dagtoml:idPrefix "IMP" ;
    dagtoml:section "implementations" ;
    dagtoml:definedByKind "traceability" ;
    rdfs:comment "Implementation work package." .

dagtoml:Code a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "code" ;
    dagtoml:layer "core" ;
    dagtoml:idPrefix "CODE" ;
    dagtoml:section "code" ;
    dagtoml:definedByKind "traceability" ;
    rdfs:comment "Concrete code artifact (file plus optional symbol)." .

dagtoml:Test a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "test" ;
    dagtoml:layer "core" ;
    dagtoml:idPrefix "TEST" ;
    dagtoml:section "tests" ;
    dagtoml:definedByKind "traceability" ;
    rdfs:comment "Verification artifact." .

dagtoml:Output a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "output" ;
    dagtoml:layer "core" ;
    dagtoml:idPrefix "OUT" ;
    dagtoml:section "outputs" ;
    dagtoml:definedByKind "traceability" ;
    rdfs:comment "User-visible output or deliverable. Shared prefix with implementation-DAG terminal outputs." .

dagtoml:Unit a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "unit" ;
    dagtoml:layer "core" ;
    dagtoml:idPattern "U\\d+[a-z]?" ;
    dagtoml:section "units" ;
    dagtoml:definedByKind "implementation-dag" ;
    rdfs:comment "Implementation-DAG unit." .

dagtoml:Artifact a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "artifact" ;
    dagtoml:layer "core" ;
    dagtoml:idPrefix "ART" ;
    dagtoml:section "units.*.produces" ;
    dagtoml:definedByKind "implementation-dag" ;
    rdfs:comment "Internal artifact flowing between DAG units." .

dagtoml:ArtifactClass a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "artifact_class" ;
    dagtoml:layer "core" ;
    dagtoml:idPattern "A\\d+" ;
    dagtoml:section "artifact_classes" ;
    dagtoml:definedByKind "readiness-gate" ;
    rdfs:comment "Review artifact class." .

dagtoml:Gate a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "gate" ;
    dagtoml:layer "core" ;
    dagtoml:idPattern "G\\d+" ;
    dagtoml:section "gates" ;
    dagtoml:definedByKind "readiness-gate" ;
    rdfs:comment "Readiness gate keyed to one artifact class." .

dagtoml:Contract a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "contract" ;
    dagtoml:layer "core" ;
    dagtoml:idPattern "C\\d+" ;
    dagtoml:section "contracts" ;
    dagtoml:definedByKind "contract-declaration" ;
    rdfs:comment "Declared contract." .

dagtoml:Claim a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "claim" ;
    dagtoml:layer "core" ;
    dagtoml:idPattern "E\\d+" ;
    dagtoml:section "claims" ;
    dagtoml:definedByKind "evidence-matrix" ;
    rdfs:comment "Strong review claim." .

dagtoml:Evidence a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "evidence" ;
    dagtoml:layer "core" ;
    dagtoml:idPattern "EV\\d+" ;
    dagtoml:section "evidence" ;
    dagtoml:definedByKind "evidence-matrix" ;
    rdfs:comment "Proof artifact." .

dagtoml:Matrix a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "matrix" ;
    dagtoml:layer "core" ;
    dagtoml:idPattern "M\\d+" ;
    dagtoml:section "matrix" ;
    dagtoml:definedByKind "evidence-matrix" ;
    rdfs:comment "Claim ↔ evidence linkage row." .

dagtoml:Guarantee a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "guarantee" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:idPrefix "GUAR" ;
    dagtoml:section "contract.guarantees" ;
    dagtoml:definedByKind "spec-contract" ;
    rdfs:comment "Measurable guarantee the implementation is held to." .

dagtoml:Invariant a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "invariant" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:idPrefix "INV" ;
    dagtoml:section "contract.invariants" ;
    dagtoml:definedByKind "spec-contract" ;
    rdfs:comment "Invariant the implementation MUST not violate." .

dagtoml:NonGoal a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "non_goal" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:idPrefix "NG" ;
    dagtoml:section "contract.non_goals" ;
    dagtoml:definedByKind "spec-contract" ;
    rdfs:comment "Explicit non-goal of the change." .

dagtoml:Threat a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "threat" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:idPrefix "THREAT" ;
    dagtoml:section "threats" ;
    dagtoml:definedByKind "threat-model" ;
    rdfs:comment "Identified threat to the change or system." .

dagtoml:SmokeCheck a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "smoke_check" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:idPrefix "SMOKE" ;
    dagtoml:section "checks" ;
    dagtoml:definedByKind "smoke-validation" ;
    rdfs:comment "Smoke-validation check entry." .

dagtoml:RollbackTrigger a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "rollback_trigger" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:idPrefix "TRIG" ;
    dagtoml:section "rollback.triggers" ;
    dagtoml:definedByKind "rollback-plan" ;
    rdfs:comment "Pre-declared rollback trigger condition." .

dagtoml:COST a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "COST" ;
    dagtoml:layer "profile:cost" ;
    dagtoml:idPrefix "COST" ;
    dagtoml:section "record" ;
    dagtoml:definedByKind "cost-record" ;
    rdfs:comment "A single cost-record entry: the declared cost of one costed action, witnessed by `producer_id` at `incurred_at`, decided by `decider_class`, with a closed-set dimensions array." .

dagtoml:DisclosureAttestation a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "disclosure_attestation" ;
    dagtoml:layer "profile:disclosure" ;
    dagtoml:idPrefix "DISC" ;
    dagtoml:section "attestations" ;
    dagtoml:definedByKind "disclosure-attestation" ;
    rdfs:comment "A disclosure attestation entry: one signed statement that a named subject was disclosed under a stated posture." .

dagtoml:Redaction a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "redaction" ;
    dagtoml:layer "profile:disclosure" ;
    dagtoml:idPrefix "RED" ;
    dagtoml:section "redactions" ;
    dagtoml:definedByKind "redaction-manifest" ;
    rdfs:comment "A redaction entry: one byte-range or field-path inside the source artifact that was removed before publication, with justification." .

dagtoml:SelectiveDisclosureProof a rdfs:Class ;
    rdfs:subClassOf ijb:Thing ;
    rdfs:label "selective_disclosure_proof" ;
    dagtoml:layer "profile:disclosure" ;
    dagtoml:idPrefix "SDP" ;
    dagtoml:section "proofs" ;
    dagtoml:definedByKind "selective-disclosure-proof" ;
    rdfs:comment "A selective disclosure proof: a commitment a recipient can verify to confirm the published bytes are a faithful redaction of the bound source." .

###
### Relation predicates (31 = one per [[relations]] block in core/ontology.toml)
###

dagtoml:derived_from a rdf:Property ;
    rdfs:label "derived_from" ;
    rdfs:domain dagtoml:Intent ;
    rdfs:range dagtoml:Intent ;
    dagtoml:cardinality "0..*" .

dagtoml:realized_by a rdf:Property ;
    rdfs:label "realized_by" ;
    rdfs:domain dagtoml:Intent ;
    rdfs:range [ a owl:Class ; owl:unionOf ( dagtoml:Feature dagtoml:Requirement ) ] ;
    owl:inverseOf dagtoml:realizes ;
    dagtoml:cardinality "0..*" .

dagtoml:realizes a rdf:Property ;
    rdfs:label "realizes" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( dagtoml:Feature dagtoml:Code dagtoml:Output ) ] ;
    rdfs:range [ a owl:Class ; owl:unionOf ( dagtoml:Intent dagtoml:Implementation dagtoml:Requirement dagtoml:Feature ) ] ;
    owl:inverseOf dagtoml:realized_by ;
    dagtoml:cardinality "0..*" ;
    rdfs:comment "FEAT targets INT; CODE targets IMP and REQ; OUT targets FEAT and INT." .

dagtoml:constrained_by a rdf:Property ;
    rdfs:label "constrained_by" ;
    rdfs:domain dagtoml:Feature ;
    rdfs:range [ a owl:Class ; owl:unionOf ( dagtoml:Requirement dagtoml:Regulation ) ] ;
    owl:inverseOf dagtoml:constrains ;
    dagtoml:cardinality "0..*" .

dagtoml:implemented_by a rdf:Property ;
    rdfs:label "implemented_by" ;
    rdfs:domain dagtoml:Feature ;
    rdfs:range dagtoml:Implementation ;
    owl:inverseOf dagtoml:implements ;
    dagtoml:cardinality "0..*" .

dagtoml:produces a rdf:Property ;
    rdfs:label "produces" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( dagtoml:Feature dagtoml:Unit ) ] ;
    rdfs:range [ a owl:Class ; owl:unionOf ( dagtoml:Output dagtoml:Artifact ) ] ;
    dagtoml:cardinality "0..*" ;
    rdfs:comment "FEAT targets OUT; DAG units target ART and OUT." .

dagtoml:constrains a rdf:Property ;
    rdfs:label "constrains" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( dagtoml:Requirement dagtoml:Regulation ) ] ;
    rdfs:range [ a owl:Class ; owl:unionOf ( dagtoml:Feature dagtoml:Implementation dagtoml:Requirement ) ] ;
    owl:inverseOf dagtoml:constrained_by ;
    dagtoml:cardinality "0..*" ;
    rdfs:comment "REQ targets FEAT and IMP. REG targets REQ and IMP (regulations bind requirements, not features directly). Inverse `constrained_by` only applies to the FEAT side." .

dagtoml:verified_by a rdf:Property ;
    rdfs:label "verified_by" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( dagtoml:Requirement dagtoml:Regulation ) ] ;
    rdfs:range dagtoml:Test ;
    owl:inverseOf dagtoml:verifies ;
    dagtoml:cardinality "0..*" ;
    rdfs:comment "Entity-typed traceability variant. Contracts also use a field named `verified_by` but that is free-form and is declared separately in the review-readiness section below." .

dagtoml:addresses a rdf:Property ;
    rdfs:label "addresses" ;
    rdfs:domain dagtoml:Decision ;
    rdfs:range [ a owl:Class ; owl:unionOf ( dagtoml:Requirement dagtoml:Regulation ) ] ;
    dagtoml:cardinality "0..*" .

dagtoml:shapes a rdf:Property ;
    rdfs:label "shapes" ;
    rdfs:domain dagtoml:Decision ;
    rdfs:range [ a owl:Class ; owl:unionOf ( dagtoml:Implementation dagtoml:Code ) ] ;
    dagtoml:cardinality "0..*" .

dagtoml:supersedes a rdf:Property ;
    rdfs:label "supersedes" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( dagtoml:Decision dagtoml:Contract ) ] ;
    rdfs:range [ a owl:Class ; owl:unionOf ( dagtoml:Decision dagtoml:Contract ) ] ;
    dagtoml:cardinality "0..*" ;
    rdfs:comment "Target entity kind MUST match source. Chains MUST be acyclic." .

dagtoml:implements a rdf:Property ;
    rdfs:label "implements" ;
    rdfs:domain dagtoml:Implementation ;
    rdfs:range [ a owl:Class ; owl:unionOf ( dagtoml:Feature dagtoml:Requirement ) ] ;
    owl:inverseOf dagtoml:implemented_by ;
    dagtoml:cardinality "0..*" .

dagtoml:guided_by a rdf:Property ;
    rdfs:label "guided_by" ;
    rdfs:domain dagtoml:Implementation ;
    rdfs:range dagtoml:Decision ;
    dagtoml:cardinality "0..*" .

dagtoml:code a rdf:Property ;
    rdfs:label "code" ;
    rdfs:domain dagtoml:Implementation ;
    rdfs:range dagtoml:Code ;
    dagtoml:cardinality "0..*" .

dagtoml:tests a rdf:Property ;
    rdfs:label "tests" ;
    rdfs:domain dagtoml:Implementation ;
    rdfs:range dagtoml:Test ;
    dagtoml:cardinality "0..*" .

dagtoml:downstream_outputs a rdf:Property ;
    rdfs:label "downstream_outputs" ;
    rdfs:domain dagtoml:Implementation ;
    rdfs:range dagtoml:Output ;
    dagtoml:cardinality "0..*" .

dagtoml:verifies a rdf:Property ;
    rdfs:label "verifies" ;
    rdfs:domain dagtoml:Test ;
    rdfs:range [ a owl:Class ; owl:unionOf ( dagtoml:Requirement dagtoml:Regulation ) ] ;
    owl:inverseOf dagtoml:verified_by ;
    dagtoml:cardinality "0..*" .

dagtoml:depends_on a rdf:Property ;
    rdfs:label "depends_on" ;
    rdfs:domain dagtoml:Unit ;
    rdfs:range dagtoml:Unit ;
    owl:inverseOf dagtoml:blocks ;
    dagtoml:cardinality "0..*" ;
    rdfs:comment "MUST be the exact inverse of `blocks`." .

dagtoml:blocks a rdf:Property ;
    rdfs:label "blocks" ;
    rdfs:domain dagtoml:Unit ;
    rdfs:range dagtoml:Unit ;
    owl:inverseOf dagtoml:depends_on ;
    dagtoml:cardinality "0..*" .

dagtoml:consumes a rdf:Property ;
    rdfs:label "consumes" ;
    rdfs:domain dagtoml:Unit ;
    rdfs:range dagtoml:Artifact ;
    dagtoml:cardinality "0..*" ;
    rdfs:comment "Each entry MUST match an existing `produces` entry." .

dagtoml:artifact_class a rdf:Property ;
    rdfs:label "artifact_class" ;
    rdfs:domain dagtoml:Gate ;
    rdfs:range dagtoml:ArtifactClass ;
    dagtoml:cardinality "1" ;
    rdfs:comment "Singular — each gate is keyed to exactly one artifact class." .

dagtoml:contract_depends_on a rdf:Property ;
    rdfs:label "contract:depends_on" ;
    rdfs:domain dagtoml:Contract ;
    rdfs:range dagtoml:Contract ;
    dagtoml:cardinality "0..*" ;
    rdfs:comment "Distinct from the DAG-unit `depends_on` predicate; both share the field name." .

dagtoml:contract_supersedes a rdf:Property ;
    rdfs:label "contract:supersedes" ;
    rdfs:domain dagtoml:Contract ;
    rdfs:range dagtoml:Contract ;
    dagtoml:cardinality "0..*" ;
    rdfs:comment "Contracts-scoped variant of `supersedes`; the DEC-scoped variant is declared above. Chains MUST be acyclic." .

dagtoml:related_to a rdf:Property ;
    rdfs:label "related_to" ;
    rdfs:domain dagtoml:Contract ;
    rdfs:range dagtoml:Contract ;
    dagtoml:cardinality "0..*" .

dagtoml:applies_to a rdf:Property ;
    rdfs:label "applies_to" ;
    rdfs:domain dagtoml:Contract ;
    dagtoml:targetFreeForm true ;
    dagtoml:cardinality "0..*" ;
    rdfs:comment "Free-form label set; not validated against an entity table." .

dagtoml:contract_verified_by a rdf:Property ;
    rdfs:label "contract:verified_by" ;
    rdfs:domain dagtoml:Contract ;
    dagtoml:targetFreeForm true ;
    dagtoml:cardinality "0..*" ;
    rdfs:comment "Contract `verified_by` is free-form; the traceability `verified_by` (REQ/REG -> TEST) is the entity-typed variant above." .

dagtoml:claim a rdf:Property ;
    rdfs:label "claim" ;
    rdfs:domain dagtoml:Matrix ;
    rdfs:range dagtoml:Claim ;
    dagtoml:cardinality "1" ;
    rdfs:comment "Singular. The truth-source validator also accepts the alias `claim_id`; see the separate entry below." .

dagtoml:claim_id a rdf:Property ;
    rdfs:label "claim_id" ;
    rdfs:domain dagtoml:Matrix ;
    rdfs:range dagtoml:Claim ;
    dagtoml:cardinality "1" ;
    rdfs:comment "Accepted alias of `claim`. Declared as a separate relation so machine consumers reading this file see every field name the truth-source validator accepts." .

dagtoml:evidence a rdf:Property ;
    rdfs:label "evidence" ;
    rdfs:domain dagtoml:Matrix ;
    rdfs:range dagtoml:Evidence ;
    dagtoml:cardinality "1" ;
    rdfs:comment "Singular. The truth-source validator also accepts the alias `evidence_id`; see the separate entry below." .

dagtoml:evidence_id a rdf:Property ;
    rdfs:label "evidence_id" ;
    rdfs:domain dagtoml:Matrix ;
    rdfs:range dagtoml:Evidence ;
    dagtoml:cardinality "1" ;
    rdfs:comment "Accepted alias of `evidence`. Declared as a separate relation so machine consumers reading this file see every field name the truth-source validator accepts." .

dagtoml:cites_upstream a rdf:Property ;
    rdfs:label "cites_upstream" ;
    dagtoml:targetFreeForm true ;
    dagtoml:cardinality "0..*" ;
    rdfs:comment "Cross-kind marker that a field in a `*-kind.toml` descriptor carries an upstream artifact reference (SHA-256 digest, document URI, signed-envelope pointer) that MUST flow into the document's root-level `closure_root` digest per SPEC §12.1. Kind descriptors apply this label via `[[kind.required_fields]].ontology_mapping = \"cites_upstream\"` (or the analogous mapping inside `[[kind.required_sections]]`). The relation is intentionally typed against `unconstrained_label` on both sides — concrete artifact entity kinds are profile-defined, but the closure-root rule fires uniformly across every conforming kind." .

###
### Attribute vocabularies (50)
###

dagtoml:requirement_kind a rdf:Property ;
    rdfs:label "requirement_kind" ;
    dagtoml:layer "core" ;
    dagtoml:extensible true ;
    rdfs:domain dagtoml:Requirement ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "functional" "non_functional" "policy" "interface" "performance" "correctness" "operational" ) ] ;
    rdfs:comment "Profiles MAY add values. After first publication, additions bump ontology_version." .

dagtoml:test_kind a rdf:Property ;
    rdfs:label "test_kind" ;
    dagtoml:layer "core" ;
    dagtoml:extensible true ;
    rdfs:domain dagtoml:Test ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "unit" "integration" "e2e" "audit" "property" "robustness" "benchmark" ) ] .

dagtoml:priority a rdf:Property ;
    rdfs:label "priority" ;
    dagtoml:layer "core" ;
    dagtoml:extensible false ;
    rdfs:domain dagtoml:Requirement ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "must" "should" "could" ) ] ;
    rdfs:comment "Used by release-train policy packs to decide what may slip versus what blocks a cut." .

dagtoml:unit_status a rdf:Property ;
    rdfs:label "unit.status" ;
    dagtoml:layer "core" ;
    dagtoml:extensible false ;
    rdfs:domain dagtoml:Unit ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "pending" "in_progress" "done" "blocked" "deferred" ) ] .

dagtoml:review_status a rdf:Property ;
    rdfs:label "review.status" ;
    dagtoml:layer "core" ;
    dagtoml:extensible false ;
    dagtoml:appliesToKind dagtoml:ReadinessGateKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "draft" "blocked" "ready" "in_review" "rereview_needed" ) ] .

dagtoml:confidentiality a rdf:Property ;
    rdfs:label "confidentiality" ;
    dagtoml:layer "core" ;
    dagtoml:extensible false ;
    rdfs:domain dagtoml:Meta ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "public" "restricted" "confidential" "trade-secret" "embargoed" ) ] ;
    rdfs:comment "Closed set per spec.md §2.7. The value `embargoed` REQUIRES the companion `[meta].embargo_until` RFC 3339 field; that cross-field requirement is enforced by validators recognising the field but is not encoded as a separate vocabulary entry." .

dagtoml:license a rdf:Property ;
    rdfs:label "license" ;
    dagtoml:layer "core" ;
    dagtoml:extensible true ;
    rdfs:domain dagtoml:Meta ;
    rdfs:comment "Intentionally free-form. SHOULD be an SPDX identifier or `LicenseRef-…` prefix per spec.md §2.7. The SPDX list changes faster than this spec; validators MUST treat the value as an opaque declared posture and MUST NOT resolve it against an external registry." .

dagtoml:framework_profile_namespace a rdf:Property ;
    rdfs:label "framework_profile_namespace" ;
    dagtoml:layer "core" ;
    dagtoml:extensible false ;
    rdfs:domain dagtoml:Meta ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "spec-reserved" "reverse-dns" ) ] ;
    rdfs:comment "Closed partition per SPEC §2.5. `spec-reserved` covers unprefixed kebab-case names spec-reserved by this spec; `reverse-dns` covers everything else (third-party / private). The value sits in the `profile-descriptor` `[profile].namespace` field, not in instance file metadata directly." .

dagtoml:provenance_encryption_hash_is_over a rdf:Property ;
    rdfs:label "provenance.encryption.hash_is_over" ;
    dagtoml:layer "core" ;
    dagtoml:extensible false ;
    rdfs:domain dagtoml:Provenance ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "plaintext" "ciphertext" ) ] ;
    rdfs:comment "Closed set per SPEC §11.1. Determines whether the standard SHA-256 + byte-length recomputation in `validate_provenance.py` applies (ciphertext) or is downgraded to advisory (plaintext)." .

dagtoml:closure_root_digest_algorithm a rdf:Property ;
    rdfs:label "closure_root.digest_algorithm" ;
    dagtoml:layer "core" ;
    dagtoml:extensible true ;
    rdfs:domain dagtoml:DocumentRoot ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "sha256" "sha384" "sha512" ) ] ;
    rdfs:comment "Closed-for-now set of digest algorithms permitted as the prefix on a root-level `closure_root` field (SPEC §12.1). Extension is reserved for stronger / post-quantum digests as they become widely deployed; weaker algorithms (MD5, SHA-1) are forbidden by the spec text and MUST NOT be added. The closure-root rule is independent of the digest choice — only the algorithm tag in the field's value is bounded here." .

dagtoml:capability_envelope_domain a rdf:Property ;
    rdfs:label "capability_envelope.domain" ;
    dagtoml:layer "core" ;
    dagtoml:extensible false ;
    rdfs:domain dagtoml:KindDescriptor ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "filesystem" "sockets" "http" "clocks" "random" "environment" "process_spawn" "ipc" "crypto_keys" ) ] ;
    rdfs:comment "Closed set of capability-domain sub-table names legal under `[kind.capability_envelope]` in any `*-kind.toml` descriptor (SPEC §13.3). Drawn from WASI Preview 2 WIT interfaces for portability across enforcement backends (Linux seccomp+landlock, FreeBSD Capsicum, macOS sandbox-exec, Wasmtime). A descriptor that uses a sub-table name outside this set is structurally invalid. Adding a new domain is a SPEC amendment that bumps `schema_version`. A domain whose sub-table is missing from a descriptor is treated as denied — fail-closed default per SPEC §13.9." .

dagtoml:abstraction_class_id_pattern a rdf:Property ;
    rdfs:label "abstraction_class.id_pattern" ;
    dagtoml:layer "core" ;
    dagtoml:extensible false ;
    rdfs:domain dagtoml:KindDescriptor ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "<slug>.v<integer>" ) ] ;
    rdfs:comment "The shape (not the value set) of `[kind.abstraction_class].id` per SPEC §13.2. `<slug>` is producer-attested free-form; the `v<integer>` suffix is REQUIRED and monotonic. This vocabulary intentionally enumerates the *pattern* rather than the *values* — the value space is open by design (producers declare their own taxonomy) but the shape is closed (the `v<integer>` versioning enables consumers to reject class-version drift via the SPEC §12 closure-root cascade)." .

dagtoml:trigger_kind a rdf:Property ;
    rdfs:label "trigger_kind" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible true ;
    rdfs:domain dagtoml:RollbackTrigger ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "error_rate_threshold" "behavioral_anomaly_detected" "determinism_regression" "perf_regression" "memory_safety_regression" "data_corruption" "windows_ci_regression" "validator_failure" "missing_evidence" "manual_override" ) ] ;
    rdfs:comment "Defined by the Agent Assurance Profile. `windows_ci_regression` is a platform-specific template value; rename per platform when adopting. The `validator_failure`, `missing_evidence`, and `manual_override` values cover spec-authoring and audit-flow rollbacks where the trigger is a tooling outcome rather than a runtime metric. After first publication, adding values bumps THIS profile's ontology_version (not the core ontology_version)." .

dagtoml:likelihood a rdf:Property ;
    rdfs:label "likelihood" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible false ;
    rdfs:domain dagtoml:Threat ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "negligible" "low" "medium" "high" "critical" ) ] .

dagtoml:impact a rdf:Property ;
    rdfs:label "impact" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible false ;
    rdfs:domain dagtoml:Threat ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "negligible" "low" "medium" "high" "critical" ) ] .

dagtoml:residual_risk a rdf:Property ;
    rdfs:label "residual_risk" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible false ;
    rdfs:domain dagtoml:Threat ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "accepted" "mitigated" "open" ) ] .

dagtoml:smoke_decision a rdf:Property ;
    rdfs:label "smoke.decision" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible false ;
    dagtoml:appliesToKind dagtoml:SmokeValidationKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "pass" "fail" "inconclusive" ) ] ;
    rdfs:comment "Applies to the top-level [result].decision field of a smoke-validation file. `applies_to` here names the schema/template_kind because the field lives on a singleton table, not on an id-prefixed entity. By contrast, the `status` vocabulary below uses `applies_to = \"SMOKE\"` because it lives on individual `[[checks]]` entries." .

dagtoml:status a rdf:Property ;
    rdfs:label "status" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible false ;
    rdfs:domain dagtoml:SmokeCheck ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "pass" "fail" "inconclusive" ) ] ;
    rdfs:comment "Per-check status on [[checks]] entries. Same value set as smoke.decision." .

dagtoml:runtime_kind a rdf:Property ;
    rdfs:label "runtime_kind" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible false ;
    dagtoml:appliesToKind dagtoml:AdapterContractKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "wasi-component" "oci-action" "os-sandbox" ) ] ;
    rdfs:comment "Declared runtime family for an adapter. SPEC layer only records the choice; execution is RUNTIME-SPEC." .

dagtoml:runtime_network_policy a rdf:Property ;
    rdfs:label "runtime_network_policy" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible false ;
    dagtoml:appliesToKind dagtoml:AdapterContractKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "denied" "loopback-only" "allowlist" "open" ) ] ;
    rdfs:comment "Network capability the runtime must enforce. `denied` MUST mean no socket capability of any kind, including loopback." .

dagtoml:runtime_clock_policy a rdf:Property ;
    rdfs:label "runtime_clock_policy" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible false ;
    dagtoml:appliesToKind dagtoml:AdapterContractKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "injected" "source-date-epoch" "monotonic-from-zero" "host-wall-clock" ) ] ;
    rdfs:comment "Clock semantics the runtime exposes to the adapter. Determinism-bearing adapters MUST NOT use host-wall-clock." .

dagtoml:input_hash_method a rdf:Property ;
    rdfs:label "input_hash_method" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible true ;
    dagtoml:appliesToKind dagtoml:AdapterContractKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "sha256-bytes" "sha256-jcs" "sha256-cbor-deterministic" ) ] ;
    rdfs:comment "How an adapter's raw input is canonicalized before hashing. Extensible per ontology rules." .

dagtoml:adapter_id_derivation a rdf:Property ;
    rdfs:label "adapter_id_derivation" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible false ;
    dagtoml:appliesToKind dagtoml:AdapterContractKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "content-hash" "nonce" "external" ) ] ;
    rdfs:comment "How the adapter derives assertion IDs. `content-hash` is required for reproducibility-bearing adapters." .

dagtoml:gate_decision_verdict a rdf:Property ;
    rdfs:label "gate_decision_verdict" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible false ;
    dagtoml:appliesToKind dagtoml:GateDecisionKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "pass" "fail" ) ] ;
    rdfs:comment "Mechanical gate verdict. Closed two-value enum by design; an override does NOT introduce a third value." .

dagtoml:evidence_root_algorithm a rdf:Property ;
    rdfs:label "evidence_root_algorithm" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible true ;
    dagtoml:appliesToKind dagtoml:GateDecisionKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "sha256-merkle-sorted-leaves" "sha256-merkle-index-order" ) ] ;
    rdfs:comment "Algorithm used to compute the evidence root over cited bundle hashes. Extensible per ontology rules." .

dagtoml:record_signature_algorithm a rdf:Property ;
    rdfs:label "record_signature_algorithm" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible true ;
    dagtoml:appliesToKind dagtoml:AssertionLogRecordKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "ed25519" "ecdsa-p256" ) ] ;
    rdfs:comment "Signature algorithm for an assertion log record. Algorithm agility per ontology rules." .

dagtoml:record_hash_algorithm a rdf:Property ;
    rdfs:label "record_hash_algorithm" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible true ;
    dagtoml:appliesToKind dagtoml:AssertionLogRecordKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "sha256" ) ] ;
    rdfs:comment "Hash algorithm for record / bundle / chain hashes. Algorithm agility per ontology rules." .

dagtoml:record_canonical_form a rdf:Property ;
    rdfs:label "record_canonical_form" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible true ;
    dagtoml:appliesToKind dagtoml:AssertionLogRecordKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "deterministic-cbor" "rfc8785-jcs" ) ] ;
    rdfs:comment "Canonical serialization used as the input to record hashing." .

dagtoml:registry_scheme a rdf:Property ;
    rdfs:label "registry_scheme" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible true ;
    dagtoml:appliesToKind dagtoml:AdapterRegistryBindingKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "file" "https" "oci" "ipfs" ) ] ;
    rdfs:comment "URL scheme of an adapter registry. Custom schemes are added by extending this vocabulary." .

dagtoml:adapter_ref_syntax a rdf:Property ;
    rdfs:label "adapter_ref_syntax" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible false ;
    dagtoml:appliesToKind dagtoml:AdapterRegistryBindingKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "content-hash" "name-version-pin" ) ] ;
    rdfs:comment "Syntactic shape of an `adapter_ref` string." .

dagtoml:signer_class a rdf:Property ;
    rdfs:label "signer_class" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible true ;
    dagtoml:appliesToKind dagtoml:GateDecisionKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "human" "ai_agent" "service" ) ] ;
    rdfs:comment "Identity class of an override signer. Operand used inside authority constraint rule= strings." .

dagtoml:authority_role a rdf:Property ;
    rdfs:label "authority_role" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible true ;
    dagtoml:appliesToKind dagtoml:GateDecisionKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "author" "peer" "team-lead" "release-captain" "security-officer" "auditor" ) ] ;
    rdfs:comment "Role membership of an override signer (RBAC operand)." .

dagtoml:severity_tier a rdf:Property ;
    rdfs:label "severity_tier" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible false ;
    dagtoml:appliesToKind dagtoml:GateDecisionKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "info" "low" "medium" "high" "critical" ) ] ;
    rdfs:comment "Severity classification of a failed assertion (ABAC operand)." .

dagtoml:autonomy_tier a rdf:Property ;
    rdfs:label "autonomy_tier" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible true ;
    dagtoml:appliesToKind dagtoml:GateDecisionKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "t0" "t1" "t2" "t3" ) ] ;
    rdfs:comment "AI agent autonomy tier (AIBAC operand). Semantics deferred to RUNTIME-SPEC." .

dagtoml:override_decision_method a rdf:Property ;
    rdfs:label "override_decision_method" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible true ;
    dagtoml:appliesToKind dagtoml:GateDecisionKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "single-signer" "m-of-n" "co-signed-human-ai" ) ] ;
    rdfs:comment "How an override is authorized (operand for authority constraint rule= strings)." .

dagtoml:override_rule_operator a rdf:Property ;
    rdfs:label "override_rule_operator" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible false ;
    dagtoml:appliesToKind dagtoml:GateDecisionKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "=" "!=" "<" "<=" ">" ">=" "IN" "AND" "OR" ) ] ;
    rdfs:comment "Closed operator set permitted inside canonical authority `constraint(...)` rule= strings. The SPEC layer treats rule= contents opaquely; this vocabulary names the operator tokens RUNTIME-SPEC may legitimately recognize." .

dagtoml:subject_class a rdf:Property ;
    rdfs:label "subject_class" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible true ;
    dagtoml:appliesToKind dagtoml:GateDecisionKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "downstream-change" "self-modification" ) ] ;
    rdfs:comment "Closed-set categorization of what the gate-decision adjudicates. `self-modification` is the producer-attested marker that the subject of change IS the producer agent's own harness or source; presence of this value triggers gate-decision INV06 (cross-provider attribution required). `downstream-change` is the default category for ordinary gates. Extensible per ontology rules; runtimes adding new categories MUST also state whether the new value triggers INV06." .

dagtoml:provider_id a rdf:Property ;
    rdfs:label "provider_id" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible true ;
    dagtoml:appliesToKind dagtoml:GateDecisionKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "anthropic" "openai" "google" "xai" "mistralai" "meta" "deepseek" "qwen" "human" "other" ) ] ;
    rdfs:comment "Closed-but-extensible identifier of the LLM provider or signer class that proposed or decided a gate. Used by INV06 to verify `deciding_provider_id` differs from `proposing_provider_id` on self-modification gate-decisions. Values name the provider organization (or `human` for non-LLM signers, `other` as escape hatch). The SPEC layer treats provider identity opaquely; RUNTIME-SPEC determines how to verify it (e.g., signed attestation, API trace, witness)." .

dagtoml:model_family_id a rdf:Property ;
    rdfs:label "model_family_id" ;
    dagtoml:layer "profile:agent-assurance" ;
    dagtoml:extensible true ;
    dagtoml:appliesToKind dagtoml:GateDecisionKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "claude" "gpt" "gemini" "grok" "mistral" "llama" "deepseek" "qwen" "human" "other" ) ] ;
    rdfs:comment "Closed-but-extensible identifier of the underlying model family. Distinct from `provider_id` because one provider can ship multiple unrelated families (e.g., a vendor reselling another lab's weights) and one family can be served by multiple providers (e.g., open-weights deployed at several inference hosts). INV06 requires `deciding_model_family_id` to differ from `proposing_model_family_id`; this prevents two same-family models served by different providers from satisfying the cross-provider rule when they share the same training-data blind spots." .

dagtoml:witness_scheme a rdf:Property ;
    rdfs:label "witness_scheme" ;
    dagtoml:layer "profile:com.verivus.runtime" ;
    dagtoml:extensible false ;
    dagtoml:appliesToKind dagtoml:ApiSnapshotKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "tls-notary" "provider-signature" "tee-quote" ) ] ;
    rdfs:comment "Closed set on the [snapshot.witness].scheme field of an api-snapshot. `tls-notary` binds origin and content; `provider-signature` binds content and provider identity; `tee-quote` binds the measured capture environment. The SPEC layer records the choice only; signature/quote verification, key resolution, and freshness are RUNTIME-SPEC. `applies_to` names the schema (template_kind) rather than an id-prefix because the value lives on a singleton sub-table, mirroring how the core `closure_root.digest_algorithm` vocabulary applies to `document_root` and the agent-assurance `smoke.decision` vocabulary applies to the `smoke-validation` schema." .

dagtoml:attester_observed a rdf:Property ;
    rdfs:label "attester_observed" ;
    dagtoml:layer "profile:com.verivus.runtime" ;
    dagtoml:extensible false ;
    dagtoml:appliesToKind dagtoml:ApiSnapshotKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "request" "response" "both" ) ] ;
    rdfs:comment "Closed set on the [snapshot.witness].observed field. Bounds what a witnessed snapshot proves: an attester that saw only the response cannot witness the request descriptor, so `response` MUST NOT be read as covering request integrity. Applies only when [snapshot.witness].present is true." .

dagtoml:execution_proof_scheme a rdf:Property ;
    rdfs:label "execution_proof_scheme" ;
    dagtoml:layer "profile:com.verivus.runtime" ;
    dagtoml:extensible false ;
    dagtoml:appliesToKind dagtoml:StateMutationKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "ledger-transaction" "provider-receipt" "tee-quote" "zk-receipt" ) ] ;
    rdfs:comment "Closed set on the [execution_proof].scheme field of a state-mutation. `ledger-transaction` binds the mutation to a transaction on an external ledger; `provider-receipt` binds it to a counterparty-signed acknowledgement; `tee-quote` binds it to a measured execution environment; `zk-receipt` binds it to a verifiable-computation receipt. The SPEC layer records the choice and the digests, and enforces that a proof is present at all (RKM02). Verification of the proof itself, key and trust-root resolution, ledger inclusion, circuit and verification-key identity, and freshness are RUNTIME-SPEC. Which schemes are ACCEPTABLE for a given workflow is policy and belongs to the consuming conformance profile, not to this vocabulary: this profile fixes that a proof exists, not that any particular proof is strong enough. This distinction is contested and is stated deliberately. `provider-receipt` is materially weaker than the other three, and it has been argued that it should be removed on the grounds that a hashed counterparty acknowledgement can then satisfy a kind whose name asserts execution. It is retained because the SPEC layer verifies NO scheme, so removing the honest label for `counterparty said so` does not make weak evidence unrepresentable, it makes producers mislabel it as something stronger. The mitigations are that the scheme is a closed machine-readable token a policy engine can refuse, and that RKM06 forbids `provider-receipt` from claiming ledger finality. A consuming profile that wants cryptographic proof MUST require the scheme it wants; it MUST NOT infer strength from the presence of the table." .

dagtoml:finality_basis a rdf:Property ;
    rdfs:label "finality_basis" ;
    dagtoml:layer "profile:com.verivus.runtime" ;
    dagtoml:extensible false ;
    dagtoml:appliesToKind dagtoml:StateMutationKind ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "none" "provider-acknowledged" "ledger-confirmed" "ledger-final" ) ] ;
    rdfs:comment "Closed set on the [execution_proof].finality_basis field. Bounds what the record claims about the DURABILITY of the mutation, which the proof scheme alone does not establish: a ledger transaction hash evidences submission and inclusion, not settlement. `none` means the record evidences that the operation was executed and claims nothing about durability; `provider-acknowledged` means a counterparty accepted it; `ledger-confirmed` means included with some confirmations; `ledger-final` means final under the ledger's own finality rule. A consumer MUST NOT read any value above `none` as verified: the SPEC layer records the producer's claim, and checking it against the named ledger is RUNTIME-SPEC. The values are NOT a single linear scale, and RKM06 constrains which are legal per scheme, because durability claims are only meaningful from evidence that can carry them: `ledger-transaction` and `zk-receipt` may claim `none`, `ledger-confirmed` or `ledger-final`; `provider-receipt` may claim `none` or `provider-acknowledged` and can never assert ledger finality; `tee-quote` may claim only `none`, since attesting a measured execution environment says nothing about whether the effect persisted." .

dagtoml:cost_dimension_category a rdf:Property ;
    rdfs:label "cost_dimension_category" ;
    dagtoml:layer "profile:cost" ;
    dagtoml:extensible false ;
    rdfs:domain dagtoml:COST ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "token_equivalent" "compute_time_seconds" "storage_bytes" "bandwidth_bytes" "human_review_time_seconds" "energy_equivalent" "evidence_run_count" ) ] ;
    rdfs:comment "Closed set of cost dimension categories. The unit label inside each category is producer-attested and free-form; comparability across producers requires an explicit conversion artefact and is intentionally out of SPEC scope. Real-valued quantities are expressed by choosing a finer-grained unit label (e.g. wall-clock-milliseconds) rather than introducing a new dimension category. After first public release, adding a value bumps THIS profile's ontology_version; no value MAY be removed (brittleness over completeness)." .

dagtoml:decider_class a rdf:Property ;
    rdfs:label "decider_class" ;
    dagtoml:layer "profile:cost" ;
    dagtoml:extensible false ;
    rdfs:domain dagtoml:COST ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "deterministic_check" "llm_single" "llm_consensus" "human_reviewer" "tee_attested_compute" "notarisation" "transparency_log_write" "other" ) ] ;
    rdfs:comment "Closed set declaring the class of deciding entity that incurred the cost. Auditors read this to know what threat surface the decision defends against. `other` is deliberately present: a producer that cannot honestly place their decider in the closed set MUST use `other` and accept more suspicious treatment from downstream consumers — silent mislabelling (e.g. tagging an LLM call as `deterministic_check`) is a separation-of-duty violation visible at the schema layer. After first public release, adding a value bumps THIS profile's ontology_version; no value MAY be removed." .

dagtoml:cost_citing_kind a rdf:Property ;
    rdfs:label "cost_citing_kind" ;
    dagtoml:layer "profile:cost" ;
    dagtoml:extensible false ;
    rdfs:domain dagtoml:COST ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "gate-decision" "evidence-matrix" "assertion-bundle" "smoke-validation" "threat-model" "rollback-plan" "other" ) ] ;
    rdfs:comment "Closed set of kinds whose execution may pay a cost. A cost-record names which kind paid for it via `[record].citing_kind`; the actual citing artefact reference is in `[record].citing_ref`. `other` is present for producers running costed actions outside the listed kinds (e.g. a custom profile's costed action), accepted with the same suspicious-treatment posture as `decider_class.other`. After first public release, adding a value bumps THIS profile's ontology_version." .

dagtoml:disclosure_posture a rdf:Property ;
    rdfs:label "disclosure_posture" ;
    dagtoml:layer "profile:disclosure" ;
    dagtoml:extensible false ;
    rdfs:domain dagtoml:DisclosureAttestation ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "full" "partial" "withheld" "embargoed" ) ] ;
    rdfs:comment "Closed set declaring how the subject was disclosed. `partial` and `embargoed` SHOULD link to a redaction-manifest and/or `[meta].embargo_until`; `withheld` declares that nothing about the subject is published in this artifact set." .

dagtoml:redaction_method a rdf:Property ;
    rdfs:label "redaction_method" ;
    dagtoml:layer "profile:disclosure" ;
    dagtoml:extensible true ;
    rdfs:domain dagtoml:Redaction ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "byte-range-delete" "field-path-delete" "field-path-mask" "blob-replace" ) ] ;
    rdfs:comment "How the redaction was applied. Extensible because adopters with novel canonical forms (e.g. JSON-Patch dialects) may need to name their scheme. After first publication, additions bump THIS profile's ontology_version." .

dagtoml:redaction_reason a rdf:Property ;
    rdfs:label "redaction_reason" ;
    dagtoml:layer "profile:disclosure" ;
    dagtoml:extensible true ;
    rdfs:domain dagtoml:Redaction ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "pii" "secret" "trade-secret" "license-restricted" "third-party" "regulatory" "other" ) ] ;
    rdfs:comment "Closed posture vocabulary mirroring the kinds of justification a reviewer expects on a redaction. `other` MUST carry a free-form `notes` field on the redaction entry." .

dagtoml:proof_scheme a rdf:Property ;
    rdfs:label "proof_scheme" ;
    dagtoml:layer "profile:disclosure" ;
    dagtoml:extensible true ;
    rdfs:domain dagtoml:SelectiveDisclosureProof ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "merkle-leaf-omission" "field-commitment-omission" "blob-commitment-substitution" ) ] ;
    rdfs:comment "Family of selective-disclosure proof scheme. The SPEC layer names the family only; the wire shape of the proof is RUNTIME-SPEC. Algorithm agility per ontology rules — additions bump THIS profile's ontology_version." .

