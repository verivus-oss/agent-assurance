# Per-developer agent / MCP configuration.
# `.mcp.json` lives at the repo root by convention and local agents read
# it automatically. Because real-world entries typically include
# absolute paths to user-specific wrapper scripts and per-checkout
# workspace roots, this file is kept out of version control.
# Contributors can create their own with whichever MCP servers they
# have installed.
.mcp.json
.claude/

# Rust build artifacts for the reference tools under tools/.
# Sources, Cargo.toml, and Cargo.lock are tracked; everything cargo
# generates under target/ is regenerated by `cargo build`.
tools/*/target/

# Go build artifacts for the reference tools under tools/.
# Each Go module's binary lives at `tools/<name>/<name>` after
# `go build -o <name> ./...`. Binaries are unstripped (~3MB) and
# diverge on every rebuild — every contributor would otherwise see
# a permanent "modified" entry. Sources, go.mod, and go.sum are
# tracked; the binary is regenerated by `go build`.
tools/dagtoml-*-go/dagtoml-*-go

# Generated DuckDB artifact — produced from
# reference/database/duckdb/{schema,seed}.sql by
# tools/dagtoml-duckdb. Binary, not text-diffable, regenerated in
# seconds. Consumers build their own copy.
reference/database/duckdb/*.duckdb

# sqry MCP server's per-checkout index + analysis cache. Regenerated
# from the working tree on demand; no contributor needs another's.
.sqry/

# LaTeX build intermediates. These can be produced by docs or scratch
# TeX audits; they are regenerated by every `pdflatex` / `latexmk` run.
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Loose LaTeX label/reference scratch files at the repo root.
# Regenerated on demand; not a deliverable.
/labels.txt
/refs.txt

# Local paper/research scratch files kept out of the public spec repo.
/.gobin/
/all_links.txt
/bib_keys.txt
/cited_keys.txt
/find_matches.py
/find_matches_v2.py

# Local-only working files: style guides, scratch, personal config — never published
.local/
tools/werner-style-policy.toml
